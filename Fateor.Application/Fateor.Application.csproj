<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Bulletin\Services\IBulletinRepositoryBuilder.cs" />
	  <Compile Remove="Organization\Repositories\Interfaces\IRepositoryFactory.cs" />
	  <Compile Remove="Organization\Repositories\MySql\RepositoryFactory.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="12.0.1" />
		<PackageReference Include="GitVersion.MsBuild" Version="6.5.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
		<PackageReference Include="MigraDocCore.Rendering" Version="1.3.67" />
		<PackageReference Include="MySql.Data" Version="9.6.0" />
		<PackageReference Include="oSoft.Data" Version="1.6.1" />
		<PackageReference Include="oSoft.Data.MySql" Version="1.6.1" />
		<PackageReference Include="oSoft.Mail" Version="1.1.0" />
		<PackageReference Include="PdfSharpCore" Version="1.3.67" />
		<PackageReference Include="QRCoder" Version="1.7.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Fateor.Database.MySql\Fateor.Database.MySql.csproj" />
		<ProjectReference Include="..\Fateor.Infrastructure\Fateor.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Fateor</_Parameter1>
			<!-- The name of the project that you want the Internal class to be visible To it -->
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Credentials\Services\MLVCredential.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>MLVCredential.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Credentials\Services\MLVCredential.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>MLVCredential.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Credentials\Resources\GEOSANSLIGHT-OBLIQUE.TTF">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Credentials\Resources\GEOSANSLIGHT.TTF">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
