<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;AHVIA</Configurations>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Bulletin\Services\IBulletinRepositoryBuilder.cs" />
	  <Compile Remove="Organization\Repositories\Interfaces\IRepositoryFactory.cs" />
	  <Compile Remove="Organization\Repositories\MySql\RepositoryFactory.cs" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Credentials\Resources\Logo.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="16.3.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageReference Include="MySql.Data" Version="26.10.0" />
		<PackageReference Include="oSoft.Data" Version="1.6.1" />
		<PackageReference Include="oSoft.Data.MySql" Version="1.6.1" />
		<PackageReference Include="oSoft.Mail" Version="1.2.0" />
		<PackageReference Include="QRCoder" Version="1.8.1" />
		<PackageReference Include="QuestPDF" Version="2026.9.1" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Fateor.Database.MySql\Fateor.Database.MySql.csproj" />
		<ProjectReference Include="..\Fateor.Infrastructure\Fateor.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Fateor</_Parameter1>
			<!-- The name of the project that you want the Internal class to be visible To it -->
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Credentials\Resources\Logo.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Credentials\Services\MLVCredential.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>MLVCredential.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Credentials\Services\MLVCredential.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>MLVCredential.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Credentials\Resources\GEOSANSLIGHT-OBLIQUE.TTF">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Credentials\Resources\GEOSANSLIGHT.TTF">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
