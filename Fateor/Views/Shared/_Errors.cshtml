@model List<string>

@if (Model != null && Model.Count > 0)
{
    <div id="messages" style="display:grid; grid-template-columns: 3em 1fr;">
        <div style="color:red"><i class="fa-solid fa-triangle-exclamation fa-2xl"></i></div>
        <div>
            @for (int i = 0; i < Model.Count; i++)
            {
                <div>@Html.DisplayFor(m => Model[i])</div>
            }
        </div>
    </div>
    <script type="text/javascript">
        $("#messages").dialog({ autoOpen: true, autoResize: true });
    </script>
}
