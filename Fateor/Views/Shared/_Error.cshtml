@model List<string>

@if (Model != null && Model.Count > 0)
{
    <div id="messages">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div>@Html.DisplayFor(m => Model[i])</div>
        }
    </div>
    <script type="text/javascript">
        $("#intro").dialog({ autoOpen: true, autoResize: true });
    </script>
}
