<style type="text/css">
    header > div {
        max-width: 888px;
        margin: auto;
    }
</style>
<style type="text/css" media="screen and (max-width: 888px)">
    header > div {
        max-width: 100%;
        margin: auto;
    }
</style>
<header>
    <div style="display:flex; flex-wrap: wrap;">
        <div style="margin:auto">
            <img src="~/sites/@ViewBag.Site/img/logo-rect.png" style="margin:0; padding:0; max-height:120px;" />
        </div>
        <div style="margin:auto; max-width:30em;">
            <h3 style="">@ViewBag.Title</h3>
        </div>
    </div>
</header>