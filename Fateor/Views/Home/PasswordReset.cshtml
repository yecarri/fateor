@model Fateor.Models.PasswordResetViewModel
@{
    ViewBag.Title = "Password Reset";
    Layout = "~/Views/Shared/_External.cshtml";
}
<div class="container py-2">
    <div class="card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)
            <div class="card-header">
                <h3><span class="fas fa-key mr-2" />@ViewBag.Title</h3>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label" })
                        @Html.PasswordFor(model => model.Password, new { @class = "form-control", @autocomplete = "none" })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(model => model.Password2, htmlAttributes: new { @class = "control-label" })
                        @Html.PasswordFor(model => model.Password2, new { @class = "form-control", @autocomplete = "none" })
                        @Html.ValidationMessageFor(model => model.Password2, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="form-row">
                    <div class="col">
                        <input type="submit" value="Restablecer" class="btn btn-primary float-right mx-1" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>