@model Fateor.Models.RequestPasswordResetViewModel

@{
    Layout = "~/Views/Shared/_External.cshtml";
}

<div class="container">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <h3><span class="fas fa-key" style="margin-right:0.5em;"></span>Restablecer la Contraseña</h3>
        <div style="margin-top:1em;">Te enviaremos un correo electrónico con un enlace para que restablezcas tu contraseña.</div>
        <div style="margin-top:1em;" class="form-field">
            @Html.LabelFor(model => model.Login, htmlAttributes: new { @class = "control-label " })
            @Html.EditorFor(model => model.Login, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Login)
        </div>

        <div class="form-field">
            @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label " })
            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Email)
        </div>
        <input type="submit" style="margin-top: 1em;" value="Restablecer" class="form-button" />
    }
</div>
