@model Fateor.Models.UserViewModel
@{
    ViewBag.Title = "Restablecer la Contraseña";
    Layout = "~/Views/Shared/_External.cshtml";
}

<div class="container py-2">
    <div class="card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="card-header">
                <h3><span class="fas fa-key mr-2" />@ViewBag.Title</h3>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col">
                        <p>
                            Te enviaremos un correo electrónico con un enlace para que restablezcas tu contraseña.
                        </p>
                    </div>
                </div>
                <div class="form-group col-md-4">
                    @Html.LabelFor(model => model.Login, htmlAttributes: new { @class = "control-label " })
                    @Html.EditorFor(model => model.Login, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Login, "", new { @class = "text-danger" })
                </div>

                <div class="form-group col-md-4">
                    @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label " })
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="card-footer">
                <div class="form-row">
                    <div class="col">
                        <input type="submit" value="Restablecer" class="btn btn-primary float-right mx-1" />
                    </div>
                </div>
            </div>
        }

    </div>
</div>


