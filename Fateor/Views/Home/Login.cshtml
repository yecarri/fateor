@model Fateor.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_External.cshtml";
}
<link href="~/lib/fontawesome/css/all.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div style="width:19em; display:block; margin:auto">
        <div class="form-field">
            <span class="fas fa-user"></span>
            @Html.TextBoxFor(m => m.Email, new { @required = "required",  @autocomplete = "none", placeholder = "Login", @style="margin-left:0.5em;" })
            
        </div>
        <div style="margin-left:1.6em;margin-top:0.5em;">
            Usa tu &nbsp;<span style="font-weight:700">login</span>, no el email, por favor
        </div>

        <div class="form-field">
            <span class="fas fa-key"></span>@Html.PasswordFor(m => m.Password, new { @required = "required", @class = "form-control", @autocomplete = "none", placeholder = "Contraseña", @style="margin-left:0.5em;"  })
        </div>
        <button type="submit" class="form-button" style="display:block; width:15em; margin:auto; margin-top:1em;" name="login">Entrar</button>
        <button type="button" class="form-button" style="display:block; width:15em; margin:auto; margin-top:0.2em;" onclick="document.location.href='@Url.Action("RequestPasswordChange","Home")'">No recuerdo la contrase&ntilde;a</button>
        <button type="button" class="form-button" style="display:block; width:15em; margin:auto; margin-top:0.2em;" onclick="document.location.href='@Url.Action("Registration","Member")'">Quiero hacerme miembro</button>
    </div>

}

