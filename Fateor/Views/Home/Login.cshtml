@model Fateor.Models.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_External.cshtml";
}
<link href="~/lib/fontawesome/css/all.css" rel="stylesheet" />
<div class="container py-5">
    @using (Html.BeginForm())
    {
        <div class="card" style="max-width:20em; margin: auto;">
            <div class="card-header"><h3>Login</h3></div>
            <div class="card-body">

                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="input-group">
                        <div class="input-group-prepend"><div class="input-group-text"><span class="fas fa-user"></span></div></div>
                        @Html.TextBoxFor(m => m.Email, new { @required = "required", @class = "form-control", @autocomplete = "none", placeholder = "Login" })
                    </div>
                    <div class="input-group small">
                        Usa tu &nbsp;<span style="font-weight:700">login</span>, no el email, por favor
                    </div>

                    <div class="input-group mt-2">
                        <div class="input-group-prepend"><div class="input-group-text"><span class="fas fa-key"></span></div></div>
                        @Html.PasswordFor(m => m.Password, new { @required = "required", @class = "form-control", @autocomplete = "none", placeholder = "Contraseña" })
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row mb-1">
                    <div class="col">
                        <button type="submit" name="login" class="btn btn-primary float-right">Entrar</button>
                    </div>
                </div>
                <div class="row mb-1">
                    <div class="col">
                        <button type="button" class="btn btn-secondary btn-sm w-75 float-right" onclick="document.location.href='@Url.Action("RequestPasswordChange","Home")'">No recuerdo la contrase&ntilde;a</button>
                    </div>
                </div>

                <div class="row mb-1">
                    <div class="col">
                        <button type="button" class="btn btn-secondary btn-sm w-75 float-right" onclick="document.location.href='@Url.Action("Registration","Member")'">Quiero hacerme miembro</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
