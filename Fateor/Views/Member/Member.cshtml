@model Fateor.Models.MemberViewModel
@{
}
<h5>Datos Personales</h5>
<div class="form-section">
    <div class="form-field">
        @Html.LabelFor(model => model.GivenName)
        @Html.EditorFor(model => model.GivenName)
        @Html.ValidationMessageFor(model => model.GivenName, "", new { @class = "text-danger" })
    </div>
    <div class="form-field">
        @Html.LabelFor(model => model.Surname)
        @Html.EditorFor(model => model.Surname)
        @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-4"></div>
</div>
<div class="form-section">
    <div class="form-field">
        @Html.LabelFor(model => model.IdentityDocumentTypeId)
        @Html.DropDownListFor(model => model.IdentityDocumentTypeId,
        new SelectList(Model.DocumentTypes, "IdentityDocumentTypeId", "IdentityDocument"),
        new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.IdentityDocumentTypeId, "", new { @class = "text-danger" })

    </div>
    <div class="form-field">
        @Html.LabelFor(model => model.IdentityDocumentNumber)
        @Html.EditorFor(model => model.IdentityDocumentNumber)
        @Html.ValidationMessageFor(model => model.IdentityDocumentNumber, "", new { @class = "text-danger" })
    </div>
    <div class="form-field">
        @Html.LabelFor(model => model.BirthDate)
        @Html.TextBoxFor(model => model.BirthDate, "{0:yyyy-MM-dd}",
        new
        {
        @type = "date"
        })
        @Html.ValidationMessageFor(model => model.BirthDate, "", new { @class = "text-danger" })
    </div>
</div>
<h5>Datos de Contacto</h5>
<div class="form-section">
    <div class="form-field">
        @Html.LabelFor(model => model.Email)
        @Html.EditorFor(model => model.Email)
        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
    </div>
    <div class="form-field">
        @Html.LabelFor(model => model.Phone)
        @Html.EditorFor(model => model.Phone)
        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-section">
    <div class="form-field">
        @Html.LabelFor(model => model.Address1)
        @Html.EditorFor(model => model.Address1)
        @Html.ValidationMessageFor(model => model.Address1, "", new { @class = "text-danger" })

    </div>
    <div class="form-field">
        <label style="font-size:.66rem;">Dirección (2ª línea)</label>
        @Html.EditorFor(model => model.Address2)
        @Html.ValidationMessageFor(model => model.Address2, "", new { @class = "text-danger" })
    </div>   
    <div class="form-field">
        @Html.LabelFor(model => model.CountryId)
        @Html.DropDownListFor(model => model.CountryId, new SelectList(Model.Countries, "CountryId", "CountryName"),
        new { @class = "form-control", @onchange = "onCountryChanged();" })
        @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
    </div>
    <div class="form-field">
        @Html.LabelFor(model => model.RegionId)
        @Html.DropDownListFor(model => model.RegionId, new SelectList(Model.Regions, "RegionId", "RegionName"),
        new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.RegionId, "", new { @class = "text-danger" })
    </div>
    <div class="form-field">
        @Html.LabelFor(model => model.City)
        @Html.EditorFor(model => model.City)
        @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
    </div>
    <div class="form-field">
        @Html.LabelFor(m => Model.PostCode)
        @Html.EditorFor(model => model.PostCode)
        @Html.ValidationMessageFor(model => model.PostCode, "", new { @class = "text-danger" })
    </div>

</div>
