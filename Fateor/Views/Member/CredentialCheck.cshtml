@model Fateor.Models.MemberViewModel

@{
    ViewBag.Title = "CredentialCheck";
    Layout = "~/Views/Shared/_External.cshtml";
}

<div class="container py-2">
    <div class="card">
        <div class="card-header">
            <h3>Credencial Válida</h3>
        </div>
        <div class="card-body">
            La credencial consultada fue emitida para @Html.DisplayFor(m => Model.GivenName) @Html.DisplayFor(m => Model.Surname) y es válida.
        </div>
        <div class="card-footer">
            &nbsp;
        </div>
    </div>
</div>

