@model Fateor.Models.MemberViewModel
@{
    ViewBag.Title = "Editar Miembro";
    Layout = "~/Views/Shared/_Internal.cshtml";
}
@section Scripts
    {
    <script src="~/Scripts/regions.js"></script>
    <script type="text/javascript">
        function submitForm(command) {
            $("#@Html.IdFor(m=>m.Command)").val(command);
            document.forms[0].submit();
        }

        function onCountryChanged() {
            var url = '@Url.Content("~/api/country")';
            setRegions(url, '#@Html.IdFor(m=> Model.CountryId)', '#@Html.IdFor(m=> Model.RegionId)');
        }
    </script>
}
    <div class="container py-2">
        <div class="card">
        @using (Model.New ? Html.BeginForm("Create", "Member", FormMethod.Post) : Html.BeginForm("Edit", "Member", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Command)            
            <div class="card-header">
                <h3>@(Model.New ? "Nuevo Registro" : $"{Model.GivenName} {Model.Surname}")</h3>
            </div>
            <div class="card-body">
                @Html.HiddenFor(model => model.MemberId)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <partial name="Member"></partial>                
                <div class="form-row">
                    <div class="form-group col-md-4">
                        @{
                            bool hasCredential = !string.IsNullOrWhiteSpace(Model.MemberCode);
                            object memberCodeHtmlAttributes = hasCredential ? 
                                (object) (new { @class = "form-control", @readonly = "true" }) : 
                                (object) (new { @class = "form-control" });
                        }
                        @Html.LabelFor(model => model.MemberCode, htmlAttributes: new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.MemberCode, memberCodeHtmlAttributes)
                        @Html.ValidationMessageFor(model => model.MemberCode, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    @if (hasCredential)
                    {
                                        <input type="button" class="btn btn-secondary" style="margin-top: 1.7rem;" onclick="submitForm('PrintCredential')" value="Imprimir Credencial" />
                    }
                    else
                    {
                                        <input type="button" class="btn btn-secondary" style="margin-top: 1.7rem;" onclick="submitForm('AssignMemberCode')" value="Asignar Credencial" />
                    }
                </div>
                <div class="form-group col-md-4">
                    <div style="padding-top:2.5rem;">
                        @Html.CheckBoxFor(model => model.IsDeleted, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.LabelFor(model => model.IsDeleted, htmlAttributes: new { @class = "control-label" })
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="col-12">
                    <h5>Historial</h5>
                    <table id="status" class="table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Sección</th>
                                <th>Estatus</th>
                                <th>Actualizado por</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MemberStatuses != null)
                            {
                                for (int i = 0; i < Model.MemberStatuses.Count; i++)
                                {
                                                        @Html.EditorFor(m => Model.MemberStatuses[i])
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="form-row">
                <div class="col-12">
                    <h5>Cuestionarios</h5>
                    <table id="status" class="table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Cuestionario</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Responses != null)
                            {
                                for (int i = 0; i < Model.Responses.Count; i++)
                                {
                                                        @Html.EditorFor(m => Model.Responses[i])
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <input type="hidden" value="@Model.MemberId" name="id" />
        <div class="card-footer">
            <div class="col-md-4 offset-md-8">
                <input type="button" value="Volver" class="btn btn-secondary" onclick="document.location.href = '@Url.Action("List")';" />
                <input type="button" value="Cambiar Estatus" class="btn btn-secondary" onclick="document.location.href = '@Url.Content("~/Member/UpdateStatus")/@Model.MemberId';" />
                <input type="button" value="Guardar" class="btn btn-primary" onclick="submitForm('Save');" />
            </div>
        </div>
        }
    </div>
    @if (Model.Messages?.Count > 0)
    {
    <div class="card bg-warning mt-2">

        <div class="container">
            <partial name="_Error" model="Model.Messages">            
        </div>

    </div>
    }
</div>