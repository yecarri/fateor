@model Fateor.Models.MemberFeeBatchListViewModel
@{
}
@section Scripts
{
    <style type="text/css">
        table{
            width: 100%;
        }
    </style>
}
<div class="py-2 container">
    <div class="card">
        <div class="card-header"><h3>Lotes de Cuotas</h3></div>
        @using (Html.BeginForm(FormMethod.Post))
        {
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m=> m.DateFrom, htmlAttributes: new { @class = "control-label" })
                        @Html.TextBoxFor(m=> m.DateFrom, "{0:yyyy-MM-dd}", htmlAttributes: new { @type="date", @class = "form-control"})
                    </div>
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m=> m.DateTo, htmlAttributes: new { @class = "control-label" })
                        @Html.TextBoxFor(m=> m.DateTo, "{0:yyyy-MM-dd}", htmlAttributes: new { @type="date", @class = "form-control"})
                    </div>
                    <div class="col-md-2 offset-md-10">
                        <input type="submit" value="Flitrar" class="btn btn-primary" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <table>
                            <thead>
                                <tr>
                                    <th>Lote</th>
                                    <th>Fecha desde</th>
                                    <th>Fecha Hasta</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Batches != null)
                                {
                                    foreach (var b in Model.Batches)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(m=> b.BatchTitle)</td>
                                            <td>@Html.DisplayFor(m=> b.DateFrom)</td>
                                            <td>@Html.DisplayFor(m=> b.DateTo)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>