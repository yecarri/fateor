@model Fateor.Models.MemberFeeBatchViewModel
@{
}
@section Scripts
{
    <link href="~/lib/fontawesome/css/all.css" rel="stylesheet" />
    <style>
        /* Tooltip container */
        .tt {
            position: relative;
            display: inline-block;
            cursor: help;
        }

            /* Tooltip text */
            .tt .tttext {
                visibility: hidden;
                min-width: 120px;
                max-width: 360px;
                border: 1px solid #7f7f7f;
                box-shadow: 3px 3px black;
                background-color: white;
                color: #7f7f7f;
                text-align: center;
                padding: 5px;
                border-radius: 6px;
                /* Position the tt text - see examples below! */
                position: absolute;
                z-index: 1;
            }

            /* Show the tt text when you mouse over the tt container */
            .tt:hover .tttext {
                visibility: visible;
            }
    </style>
    <script type="text/javascript">
        function doSubmit(command) {
            $('#@Html.IdFor(m => m.Command)').val(command);
            window.form.sumbit();
        }
    </script>
}

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.HiddenFor(m => m.Command)
    <div class="container" style="max-width:75%;">
        <h5>Cuotas</h5>
        <div class="form-section">
            <div class="form-field">
                @Html.LabelFor(m => m.BatchTitle)
                @Html.TextBoxFor(m => m.BatchTitle, "{0:yyyy-MM-dd}", new { @class = "form-control" })
                @Html.HiddenFor(m=>m.MemberFeeBatchId)
            </div>
            <div class="form-field">
                <label for="Periodicidad">Periodicidad</label>
                @Html.DropDownListFor(m => m.Periodicity, new SelectList(Periodicity.Periodicities, "Value", "Text"), htmlAttributes: new { @class = "form-select" })
            </div>
            <div class="form-field">
                @Html.LabelFor(m => m.DateFrom)
                @Html.TextBoxFor(m => m.DateFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
            </div>
            <div class="form-field">
                @Html.LabelFor(m => m.DateTo)
                @Html.TextBoxFor(m => m.DateTo, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
            </div>
            <div class="form-field">
                @Html.LabelFor(m => m.DateDue)
                @Html.TextBoxFor(m => m.DateDue, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
            </div>
        </div>
        <div class="form-section">
            <div class="form-field">
                @Html.HiddenFor(m => m.ReferencePattern, new { @class = "form-control" })
                @Html.LabelFor(m => m.Amount)
                @Html.TextBoxFor(m => m.Amount, format: "{0:0.00}", htmlAttributes: new { @class = "form-control" })
            </div>
            <div class="form-field">
                <label>Seleccione los estatus para crear las cuotas:</label>
                @Html.ListBoxFor(m => m.SelectedStatuses, new SelectList(Model.Statuses, "StatusId", "StatusDescription"), new { @class = "form-select" })
            </div>
            <div style="display:flex;">
                <input type="submit" class="form-button" style="margin-top:auto; align-self:flex-end; margin-bottom:1em;" value="Generar" onclick="doSubmit('Generate')" />
            </div>
        </div>

        <div class="form-section">
            <label>Cuotas</label>
            <div style="border-top:inset; border-left:inset; border-right:inset; border-bottom:1px solid lightgray; width: 100%; padding:5px; display: grid; grid-template-columns: 1fr 1fr 1fr 1fr">
                <div>Apellido</div>
                <div>Nombre</div>
                <div>Referencia</div>
                <div>Importe</div>
            </div>
            <div style="border-left:inset; width: 100%; height: 200px; padding:5px; display:  grid; grid-template-columns: 1fr 1fr 1fr 1fr; overflow-y:scroll;">
                @{
                    for (int i = 0; i<Model.MemberFees.Count; i++)
                    {
                        @Html.EditorFor(x => Model.MemberFees[i])
                    }
                }
            </div>
        </div>

        <div class="form-section">
            <div class="form-field">
                <input type="submit" class="form-button float-end" value="Guardar" onclick="doSubmit('Save')" />
            </div>
        </div>
    </div>
}


<template id="feeRow">
    <input type="hidden" name="MemberFeeId" />
    <input type="hidden" name="MemberFeeBatchId" />
    <input type="hidden" name="MemberId" />
    <div><label name="GivenName"></label></div>
    <div><label name="Surname"></label></div>
    <div><label name="FeeReference"></label></div>
    <div><label name="Amount"></label></div>
    <div style="align-content:flex-start; text-align:left"><input type="checkbox" name="Paid" /></div>
    <div style="width:95%">
        <select class="form-select" name="PaymentMethodId">
            <option value="1">Transferencia</option>
            <option value="2">Tarjeta</option>
            <option value="3">Efectivo</option>
        </select>
    </div>
    <div><input type="text" class="form-control" name="PaymentReference" /></div>
    <div style="align-content:center; text-align:center"><span class="fa fa-trash-alt"></span></div>
</template>
<template class="hidden">
    <div class="col">
        <ul>
            <li>
                %FD = Fecha Desde
                <ul>
                    <li>%FD.AAAA = Año, 4 dígitos</li>
                    <li>%FD.AA = Año, 2 dígitos</li>
                    <li>%FD.MM = Mes</li>
                    <li>%FD.DD = Mes</li>
                    <li>%FD.TR= Trimestre</li>
                </ul>
            </li>
        </ul>
    </div>
    <div class="col">
        <ul>
            <li>
                %FH = Fecha Hasta
                <ul>
                    <li>%FD.AAAA = Año, 4 dígitos</li>
                    <li>%FD.AA = Año, 2 dígitos</li>
                    <li>%FD.MM = Mes</li>
                    <li>%FD.DD = Mes</li>
                    <li>%FD.TR= Trimestre</li>
                </ul>
            </li>
        </ul>
    </div>
    <div class="col">
        <ul>
            <li>
                %U = Usuario
                <ul>
                    <li>
                        %U.ID = Identificador
                    </li>
                    <li>
                        %U.N = Nombre
                    </li>
                    <li>
                        %U.A = Apellido
                    </li>
                </ul>
            </li>
        </ul>
        <p>Se puede colocar entre paréntesis el número de caracteres, por ejemplo: %U.ID(4)</p>
    </div>
</template>
