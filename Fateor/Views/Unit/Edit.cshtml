@model Fateor.Models.UnitViewModel
@{
    ViewBag.Title = "Editar Sección";
    Layout = "~/Views/Shared/_Internal.cshtml";
}
@using (Model.New ? Html.BeginForm("Create", "Unit", FormMethod.Post) : Html.BeginForm("Edit", "Unit", FormMethod.Post))
{
    <div class="container py-2">
        <div class="card">
            <div class="card-header">
                @Html.HiddenFor(m => m.UnitId)
                <h3>@Html.DisplayFor(m => m.UnitName)</h3>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>Sección</label>
                        <div>
                            @Html.TextBoxFor(model => model.UnitName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.UnitName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>Sección Padre</label>
                        <div>
                            @Html.DropDownListFor(model => model.ParentUnitId,
                        new SelectList(Model.Units, "UnitId", "UnitName", (Model.ParentUnitId ?? -1)),
                        new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ParentUnitId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>Coordinador</label>
                        <div>
                            @Html.DropDownListFor(model => model.CoordinatorId,
                        new SelectList(Model.Members, "MemberId", "FullName", (Model.CoordinatorId ?? -1)),
                        new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ParentUnitId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="col-md-3 offset-md-9">
                    <input type="button" value="Volver" class="btn btn-secondary" onclick="document.location.href = '@Url.Action("List")';" />
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                </div>
            </div>
        </div>


        @if (Model.Messages?.Count > 0)
        {
            <div class="card bg-warning mt-2">

                <div class="container text-center">
                    <partial name="Error" model="Model.Messages" />
                </div>

            </div>
        }
    </div>
}