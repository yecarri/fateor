@model ConfigViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@{
    Layout = "~/Views/Shared/_Internal.cshtml";
    var count = Model?.Current?.Length ?? 0;
}
@section Scripts
{
    <style type="text/css">
        .container
        {

        }
        table.form-table {
            width: 100%
        }

            table.form-table th, table.form-table td {
                padding: 3px;
            }

                table.form-table td textarea {
                    top: unset;
                    margin: unset;
                    padding: unset;
                    width: 100%;
                }

        .field-validation-error,
        .validation-summary-errors {
            display: none;
        }

            .field-validation-error:not(:empty),
            .validation-summary-errors:not(:empty) {
                display: block;
            }
    </style>
}
@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
    <div class="container">
        @if (count == 0)
        {
            <p>No configs available.</p>
        }
        else
        {
            <table class="form-table">
                <thead>
                    <tr>
                        <th style="width:20%">Config Code</th>
                        <th style="width:40%">Description</th>
                        <th style="width:40%">Value</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < count; i++)
                    {
                        var cfg = Model.Current[i];

                        <tr>
                            <td class="form-field">
                                @Html.DisplayFor(m => m.Current[i].ConfigCode)
                                @Html.HiddenFor(m => m.Current[i].ConfigCode)
                                @Html.HiddenFor(m => m.Current[i].ConfigTypeId)
                            </td>

                            <td class="form-field">
                                @Html.TextAreaFor(m => m.Current[i].Description, new { })
                                @Html.ValidationMessageFor(m => m.Current[i].Description, "", new { @class = "field-validation-error" })
                            </td>

                            <td class="form-field">
                                @{
                                    // decide control by ConfigTypeId
                                    var name = $"Current[{i}].ConfigValue";
                                    var id = $"Current_{i}__ConfigValue";
                                    var value = cfg.ConfigValue ?? string.Empty;
                                }

                                @if (cfg?.ConfigTypeId == 1)
                                {
                                    // 1 = Text -> textarea
                                    @Html.TextArea(name, value, new { id = id })
                                }
                                else if (cfg?.ConfigTypeId == 2 || cfg?.ConfigTypeId == 3)
                                {
                                    // 2,3 = textbox
                                    @Html.TextBox(name, value, new { id = id })
                                }
                                else if (cfg?.ConfigTypeId == 4)
                                {
                                    // 4 = checkbox -> store "true" / "false" in ConfigValue
                                    var isChecked = string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) || value == "1";
                                    <input type="checkbox" id="@id" name="@name" value="true" @(isChecked ? "checked" : "") />
                                    @* hidden placed after checkbox so when unchecked the hidden posts; when checked the checkbox value appears first in form order *@
                                    <input type="hidden" name="@name" value="false" />
                                }
                                else if (cfg?.ConfigTypeId == 5 && cfg?.Options != null)
                                {
                                    // 5 = dropdown, Options is string[]
                                    var selectList = new SelectList(cfg.Options.Select(o => new { Value = o, Text = o }), "Value", "Text", value);
                                    @Html.DropDownList(name, selectList, new { id = id })
                                }
                                else
                                {
                                    // fallback: simple textbox
                                    @Html.TextBox(name, value, new { id = id })
                                }

                                @Html.ValidationMessageFor(m => m.Current[i].ConfigValue, "", new { @class = "field-validation-error" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div>
            <button type="submit" class="form-button">Save configs</button>
        </div>
    </div>
}