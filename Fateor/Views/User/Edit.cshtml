@model Fateor.Models.UserViewModel
@{
    ViewBag.Title = "Usuario";
    Layout = "~/Views/Shared/_Internal.cshtml";
}
@section scripts
    {
    <script>
        function doPasswordReset() {
            var url = '@Url.Content($"~/api/user/{Model.UserId}/passwordreset")';
            $.ajax(
                {
                    url: url,
                    type: 'GET',
                    success: function (jqXHR) { passwordResetOk(jqXHR); },
                    error: function (jqXHR) { passwordResetFail(jqXHR); }
                }
            );
        }

        var passwordResetOk = function (jqXHR) {
            var status = jqXHR.status;
            var error = jqXHR.message;
            $('#dialogText').html("Se envió un email para cambiar el password");
            $('#pwdResetOk').dialog('open');
        }

        var passwordResetFail = function (jqXHR) {
            var status = jqXHR.status;
            var error = jqXHR.message;
            $('#pwdResetStatus').html(status);
            $('#pwdResetMessage').html(error);
            $('#pwdResetFailed').dialog('open');
        }

        $(document).ready(function () {
            $('#pwdResetOk').dialog({ autoOpen: false, autoResize: true });
            $('#pwdResetFailed').dialog({ autoOpen: false, autoResize: true });
        });
    </script>

}
<div class="container">
    @using (Model.UserId.HasValue ? Html.BeginForm("Edit", "User", FormMethod.Post) : Html.BeginForm("Create", "User", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.UserId)

        <h3>@(Model.UserId.HasValue ? "Editar Usuario" : "Nuevo Usuario")</h3>

        @Html.ValidationSummary(true, "")

        <div class="form-field">
            @Html.LabelFor(model => model.Login)
            @Html.EditorFor(model => model.Login, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Login, "")
        </div>

        <div class="form-field">
            @Html.LabelFor(model => model.Email)
            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Email, "")
        </div>

        <div class="form-checkbox" style="margin-top:1em; margin-bottom:1em;">
            @Html.EditorFor(model => model.IsExternal)
            @Html.LabelFor(model => model.IsExternal)
            @Html.ValidationMessageFor(model => model.IsExternal, "")
        </div>
        @if (Model.UserId.HasValue)
        {
            <div class="form-checkbox" style="margin-top:1em; margin-bottom:1em;">
                @Html.EditorFor(model => model.IsDeleted)
                @Html.LabelFor(model => model.IsDeleted)
                @Html.ValidationMessageFor(model => model.IsDeleted, "")
            </div>
        }
        else
        {
            <div class="form-field">
                @Html.LabelFor(model => model.Password)
                <div class="">
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Password, "")
                </div>
            </div>
        }
        <div>
            @if (Model.UserId.HasValue)
            {

                <input type="submit" value="Guardar" class="form-button" />
                <input type="button" value="Restablecer Contraseña" class="form-button" onclick="doPasswordReset();" />
                <input type="button" value="Volver" class="form-button" onclick="document.location.href='@Url.Action("List")'" />

            }
            else
            {
                <input type="submit" value="Guardar" class="form-button" />
                <input type="button" value="Volver" class="form-button" onclick="document.location.href='@Url.Action("List")'" />
            }
        </div>
    }
</div>
@if (Model.Messages?.Count > 0)
{
    <div class="container">
        <partial name="Error" model="Model.Messages" />
    </div>
}

<script type="text/javascript">
    $("#intro").dialog({ autoOpen: false, width: window.innerWidth * 0.8, height: 'auto', autoResize: true });
    $("#gdpr").dialog({ autoOpen: false, width: window.innerWidth * 0.8, height: 'auto', autoResize: true });
</script>

<div id="pwdResetOk" title="Contraseña">
    <p>Se envió un email para cambiar la contraseña</p>
</div>
<div id="pwdResetFailed" title="Contraseña">
    <p>
        Ha ocurrido un error al tratar de restablecer la contraseña.<br />
        Status: <span id="pwdResetStatus"></span><br />
        Message: <span id="pwdResetStatus"></span>
    </p>
</div>