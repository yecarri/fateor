@model Fateor.Models.QuestionnaireViewModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Internal.cshtml";
}
@section Scripts
    {
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <script type="text/javascript">
        function doSubmit(command, tags) {
            $('#@Html.IdFor(m=>m.Command)').val(command);
            $('#@Html.IdFor(m=>m.Tags)').val(tags);
            $('#form').submit();
        }

        $(window).on('load', function () {
            $("html, body").animate({ scrollTop: $(document).height() }, 1);
        });
    </script>
}

<div class="container">
    @using (Html.BeginForm("Create", "Questionnaire", FormMethod.Post, new { id = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.QuestionnaireId)
        @Html.HiddenFor(m => m.Command)
        @Html.HiddenFor(m => m.Tags)

        <h3>Cuestionario</h3>
        <div style="border:1px inset; padding: 5px; margin-bottom: 1em;">
            <div class="form-section">
                <div class="form-field">
                    <label for="@Html.NameFor(m=>m.QuestionnaireName)">Cuestionario</label>
                    @Html.TextBoxFor(model => model.QuestionnaireName, new { @style = "width: 30em;" })
                    @Html.ValidationMessageFor(model => model.QuestionnaireName, "", new { @class = "text-danger" })
                </div>
                <div class="form-field">
                    @Html.LabelFor(model => model.RedirectUrl)
                    @Html.TextBoxFor(model => model.RedirectUrl)
                    @Html.ValidationMessageFor(model => model.RedirectUrl, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            <div style="border:1px inset; padding: 5px; margin-bottom: 2em;">
                @Html.HiddenFor(m => Model.Questions[i].QuestionId)


                <div class="form-section">
                    <h4 style="display:block">Pergunta @(i + 1)</h4>
                    <button style="margin-left:1em;" class='form-button float-right @(i==0?"disabled":"")' onclick="doSubmit('MoveQuestionUp',@i)"><span class="fas fa-arrow-up" /></button>
                    <button class='form-button float-right @(i==Model.Questions.Count-1?"disabled":"")' onclick="doSubmit('MoveQuestionDown',@i)"><span class="fas fa-arrow-down" /></button>
                    <button class='form-button float-right' onclick="doSubmit('DeleteQuestion',@i)"><span class="fas fa-trash-alt" /></button>
                </div>

                <div class="form-section">
                    <div class="form-field">
                        @Html.LabelFor(model => model.Questions[i].QuestionTypeId)
                        @Html.DropDownListFor(
                model => model.Questions[i].QuestionTypeId,
                new SelectList(Model.QuestionTypes, "QuestionTypeId", "QuestionTypeName", Model.Questions[i].QuestionTypeId),
                new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Questions[i].QuestionTypeId, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-field">
                        @Html.LabelFor(model => model.Questions[i].QuestionText)
                        @Html.TextAreaFor(model => model.Questions[i].QuestionText, new { @class = "form-control", @style = "max-width: unset;" })
                        @Html.ValidationMessageFor(model => model.Questions[i].QuestionText, "", new { @class = "text-danger" })
                    </div>
                </div>

                <h5>Opciones</h5>

                @for (int j = 0; j < Model.Questions[i].Options.Count; j++)
                {
                    @Html.HiddenFor(m => Model.Questions[i].Options[j].OptionId)
                    <div class="form-section">
                        Opción @(j+1)
                        <button style="margin-left:1em; min-width:unset !important;" class='form-button float-right @(j==0?"disabled":"")' onclick="doSubmit('MoveOptionUp','@($"{i},{j}")')"><span class="fas fa-arrow-up" /></button>
                        <button style="min-width:unset" class='form-button float-right @(j==Model.Questions[i].Options.Count-1?"disabled":"")' onclick="doSubmit('MoveOptionDown','@($"{i},{j}")')"><span class="fas fa-arrow-down" /></button>
                        <button style="min-width:unset" class='form-button float-right' onclick="doSubmit('DeleteOption','@($"{i},{j}")')"><span class="fas fa-trash-alt"></span></button>
                    </div>
                    <div class="form-section">
                        <div class="form-field">
                            @Html.LabelFor(model => model.Questions[i].Options[j].OptionText)
                            @Html.TextAreaFor(model => model.Questions[i].Options[j].OptionText)
                            @Html.ValidationMessageFor(model => model.Questions[i].Options[j].OptionText, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-field">
                            @Html.LabelFor(model => model.Questions[i].Options[j].Points, htmlAttributes: new { @class = "control-label" })
                            <div>
                                @Html.TextBoxFor(model => model.Questions[i].Options[j].Points, new { @class = "form-control w-50" })
                            </div>
                            @Html.ValidationMessageFor(model => model.Questions[i].Options[j].Points, "", new { @class = "text-danger" })

                        </div>
                    </div>
                }
                <button class="form-button" onclick="doSubmit('AddOption',@i)"><span class="fas fa-plus"></span> <span style="margin-top:0;vertical-align:top; line-height:1.25;">opción</span></button>
                
            </div>
        }
        <button class="form-button" onclick="doSubmit('AddQuestion')"><span class="fas fa-plus mr-1"></span> <span style="margin-top:0;vertical-align:top; line-height:1.25;">pregunta</span></button>
        <button id="save" type="button" class="form-button float-right" onclick="doSubmit('Save')">Guardar</button>

    }

</div>